{
  "$comment": [
    "Copy to instances.json (gitignored — it holds ClientQuery API keys) and edit. This is an",
    "alternative to creating bots through the panel: the backend seeds these on startup if no",
    "instances exist yet. Bots are fully independent, so two entries may point at completely",
    "different TeamSpeak servers.",
    "",
    "The clientQuery block is only meaningful when TS3_TRANSPORT=clientquery; the gateway",
    "transport (the default) ignores it but the field is still required by the schema."
  ],
  "instances": [
    {
      "id": "party",
      "name": "Party Bot",
      "enabled": true,
      "teamspeak": {
        "host": "ts.example.com",
        "port": 9987,
        "nickname": "PartyBot",
        "channel": "Music",
        "homeChannelId": null
      },
      "serverPassword": null,
      "clientQuery": {
        "apiKey": "AAAA-BBBB-CCCC-DDDD-EEEE"
      },
      "playback": {
        "defaultVolume": 40,
        "maxTrackSeconds": 900,
        "maxPerUser": 10,
        "allowLiveStreams": false
      },
      "commands": {
        "prefix": "!",
        "requireSameChannel": true
      },
      "permissions": {
        "defaultRole": "user",
        "whitelistOnly": false
      }
    },
    {
      "id": "chill",
      "name": "Chill Bot",
      "enabled": false,
      "teamspeak": {
        "host": "other-server.example.com",
        "port": 9987,
        "nickname": "ChillBot",
        "channel": "Lounge",
        "homeChannelId": null
      },
      "serverPassword": null,
      "clientQuery": {
        "apiKey": "FFFF-GGGG-HHHH-IIII-JJJJ"
      },
      "commands": {
        "prefix": "."
      }
    }
  ]
}
