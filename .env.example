# ─── Backend ────────────────────────────────────────────────────────────────
HTTP_PORT=8080
LOG_LEVEL=info

# Bearer token guarding the REST API and the WebSocket handshake.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me

DATABASE_PATH=./data/tsmusic.db

# ─── yt-dlp ─────────────────────────────────────────────────────────────────
# yt-dlp lives in a volume, not in the image, so it can be updated without a rebuild.
YTDLP_BINARY=yt-dlp
YTDLP_AUTO_UPDATE=true
YTDLP_POT_PROVIDER_URL=http://pot-provider:4416
# Optional: cookies exported from a logged-in browser. On a VPS this is often the only
# thing that reliably beats YouTube's bot check. Mounted read-only.
# YTDLP_COOKIES_FILE=/data/cookies.txt
# Escape hatch for when YouTube changes extraction and a client override fixes it:
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=default,web_safari

FFMPEG_BINARY=ffmpeg
PACTL_BINARY=pactl

# ─── Bot instances ──────────────────────────────────────────────────────────
# Each bot is one ts3-client container with its own identity, sink and API key.
# Copy instances.example.json to instances.json, edit it, then:
#   pnpm instances:generate && docker compose up -d
#
# The ClientQuery API key is obtained once per instance through the VNC bootstrap
# (see README) and belongs in instances.json, which is gitignored.
