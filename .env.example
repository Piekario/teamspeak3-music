# ─── Backend ────────────────────────────────────────────────────────────────
HTTP_PORT=8080
LOG_LEVEL=info

# Bearer token guarding the REST API and the WebSocket handshake.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me

DATABASE_PATH=./data/tsmusic.db

# ─── yt-dlp ─────────────────────────────────────────────────────────────────
# yt-dlp lives in a volume, not in the image, so it can be updated without a rebuild.
YTDLP_BINARY=yt-dlp
YTDLP_AUTO_UPDATE=true
# Optional: a PO token provider's URL. No provider is bundled with this stack; this only
# does something if you run one yourself and point this at it.
# YTDLP_POT_PROVIDER_URL=http://pot-provider:4416
# Optional: cookies exported from a logged-in browser. On a VPS this is often the only
# thing that reliably beats YouTube's bot check. Mounted read-only.
# Cookies exported from a browser signed in to YouTube. Mounted read-only, and needed for
# anything age-restricted: YouTube serves 18+ videos only to a verified account, and no
# proxy or PO token substitutes for that. Give the path on *your* machine; compose mounts it.
#
# Export with a Netscape-format cookie extension, or:
#   yt-dlp --cookies-from-browser firefox --cookies cookies.txt --skip-download <any video>
#
# Use an account you are willing to lose: this pattern gets accounts rate-limited.
# YTDLP_COOKIES_FILE=./cookies.txt
# Escape hatch for when YouTube changes extraction and a client override fixes it:
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=default,web_safari

FFMPEG_BINARY=ffmpeg
PACTL_BINARY=pactl

# ─── Bot instances ──────────────────────────────────────────────────────────
# Bots are normally created and configured through the panel. Seeding them from a file
# instead is also possible — copy instances.example.json to instances.json (gitignored),
# edit it, and point this at it — which is mainly useful for scripted deployments.
# INSTANCES_JSON=./instances.json

# Egress proxy for everything that talks to YouTube, e.g. socks5://tunnel:1080.
# On a datacenter IP this is usually the difference between working and not. Applied to
# yt-dlp and to ffmpeg's media fetch together: a googlevideo URL is bound to the IP that
# requested it, so they must leave by the same address.
# YTDLP_PROXY=socks5://127.0.0.1:1080

# ─── Cloudflare tunnel (optional) ───────────────────────────────────────────
# Publishes the panel without opening a port on this machine. Create a tunnel in the
# Cloudflare Zero Trust dashboard (Networks → Tunnels → Create → Cloudflared), copy the
# token it shows, and route a public hostname to http://web:80.
#
# Then: docker compose --profile tunnel up -d
#
# The token carries the tunnel's credentials. Anyone holding it can serve traffic as this
# tunnel, so keep it out of git and rotate it if it leaks.
# CLOUDFLARE_TUNNEL_TOKEN=
