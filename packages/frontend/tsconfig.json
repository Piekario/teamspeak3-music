{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": true,
    "types": ["vite/client"]
  },
  // Tests run on Node's type stripping and use node: builtins. Excluding them keeps Node's
  // globals out of the browser build, where reaching for `process` or `fs` should be a
  // compile error rather than a runtime surprise.
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [{ "path": "../shared" }]
}
